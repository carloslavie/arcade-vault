# Formulario de contacto (/about) — copia este archivo a .env.local y rellénalo

# API key de https://resend.com/api-keys (re_...)
RESEND_API_KEY=

# Buzón del equipo que recibe los mensajes.
# Sin dominio verificado en Resend, debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente. Sin dominio verificado usa: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Supabase — Project Settings → API (https://supabase.com/dashboard)

# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Nunca pongas aquí la secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
